APP_MODE=development
APP_VERSION=1.0.0
APP_PORT=8000
APP_LOG=true

PASSWORD_ENCRYPTION=qwerty
JWT_TOKEN=qwerty

CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MINUTES=5
RATE_LIMIT_MAX_REQUESTS=1000

# Local (tanpa Docker)
DB_HOST=localhost
DB_USER_NAME=root
DB_PASSWORD=root
DB_DIALECT=mysql
DB_NAME=ta_project
DB_LOG=false
DB_PORT=8889

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ — chat → LLM message broker
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_CHAT_QUEUE=chat.llm.requests
RABBITMQ_CHAT_REPLY_TIMEOUT_MS=120000

# Docker Compose: salin .env.docker.example ke .env
# lalu set DB_HOST=mysql, REDIS_HOST=redis, RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
# MQTT tetap memakai HiveMQ Cloud dari .env (bukan service Docker)

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# OpenAI Text-to-Speech (web chat voice reply)
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova


# Pinecone (vector DB + integrated inference)
PINECONE_API_KEY=   
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
PINECONE_EMBEDDING_MODEL=


# MQTT — HiveMQ Cloud (broker eksternal)
MQTT_BROKER_URL=
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=

# Evaluation runner (evaluation/) — opsional, semua punya default aman
EVAL_REPETITIONS=3
EVAL_CONCURRENCY=2
EVAL_MAX_RETRIES=2
EVAL_RETRY_BASE_DELAY_MS=1000
EVAL_MQTT_ACK_TIMEOUT_MS=10000
EVAL_MQTT_ACK_POLL_INTERVAL_MS=500
# Usia maksimum data sensor (device_logs) agar dianggap bukti MQTT masih hidup — perketat
# sesuai interval push ESP32 Anda yang sebenarnya (default konservatif 15 menit)
EVAL_SENSOR_FRESHNESS_MS=900000
# Sama dengan default di evaluation/config/evaluation.config.ts — isi hanya jika ingin path lain
EVAL_DATASET_PATH=./evaluation/datasets/dataset.json
EVAL_RESULTS_DIR=./evaluation/results
EVAL_FUNCTIONAL_DATASET_PATH=./evaluation/datasets/functional-dataset.jsonl
EVAL_API_BASE_URL=http://localhost:8000
# Akun yang sudah terdaftar di sistem (dipakai untuk POST /api/v1/auth/login saat --mode functional).
# TIDAK diisi otomatis — pakai akun Anda sendiri, atau daftar baru lewat POST /api/v1/auth/register.
# (resources/seeders/1_userSeeder.js menyediakan admin1@mail.com, tapi passwordnya di-hash — isi manual
# jika Anda tahu password aslinya, jangan tebak/paksa hash-nya.)
EVAL_API_EMAIL=
EVAL_API_PASSWORD=
# Kurs USD->IDR untuk laporan (poin 18) — kosongkan/0 jika biaya cukup dilaporkan dalam USD saja.
# Tidak ada nilai baku di codebase; isi manual sesuai kurs saat pengambilan data.
EVAL_USD_TO_IDR=
# Override exact provider model id (Tabel 3.10 label tetap dipakai untuk laporan).
# Nilai di bawah ini SAMA dengan default di evaluation/config/models.config.ts — baru
# berupa tebakan terbaik dari nama Tabel 3.10, BELUM diverifikasi ke akun API sungguhan.
# WAJIB dikonfirmasi/diganti sebelum run berbayar.
EVAL_OPENAI_MODEL=gpt-5.6-luna
EVAL_ANTHROPIC_MODEL=claude-sonnet-5
EVAL_DEEPSEEK_MODEL=deepseek-v4-flash
