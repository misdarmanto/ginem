{
  "name": "ginem",
  "version": "1.0.0",
  "description": "Modern monorepo with Express API and React Dashboard",
  "private": true,
  "workspaces": [
    "packages/dashboard"
  ],
  "scripts": {
    "dev": "npm run dev:all -w packages/dashboard",
    "start": "npm run start:prod -w packages/dashboard",
    "build": "npm run build -w packages/dashboard",
    "test": "npm run test -w packages/dashboard",
    "test:run": "npm run test:run -w packages/dashboard",
    "lint": "npm run lint -w packages/dashboard",
    "lint:fix": "npm run lint:fix -w packages/dashboard",
    "clean": "rm -rf node_modules packages/*/node_modules && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0"
  }
}
