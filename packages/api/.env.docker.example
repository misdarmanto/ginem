# Salin ke .env lalu isi kredensial HiveMQ Cloud dan API key eksternal.

APP_MODE=development
APP_VERSION=1.0.0
APP_PORT=8000
APP_LOG=true

PASSWORD_ENCRYPTION=qwerty
JWT_TOKEN=qwerty

CORS_ORIGIN=http://localhost:5173

RATE_LIMIT_WINDOW_MINUTES=5
RATE_LIMIT_MAX_REQUESTS=1000

# Hostname service di docker-compose (jangan ubah kecuali rename service)
DB_HOST=mysql
DB_USER_NAME=root
DB_PASSWORD=root
DB_DIALECT=mysql
DB_NAME=ta_project
DB_LOG=false
DB_PORT=3306

REDIS_HOST=redis
REDIS_PORT=6379

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_CHAT_QUEUE=chat.llm.requests
RABBITMQ_CHAT_REPLY_TIMEOUT_MS=120000
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

DEEPSEEK_API_KEY=
OPENAI_API_KEY=

OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
PINECONE_EMBEDDING_MODEL=

# MQTT — HiveMQ Cloud (broker eksternal, tidak dijalankan di Docker)
MQTT_BROKER_URL=mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883
MQTT_CLIENT_ID=mqtt-worker-dev
MQTT_USERNAME=
MQTT_PASSWORD=

# Jalankan migration otomatis saat container start (true/false)
RUN_MIGRATIONS=true
