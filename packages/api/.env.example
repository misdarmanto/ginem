# App
APP_VERSION=1.0.0
APP_MODE=development
APP_ENV=development
APP_PORT=8000
APP_LOG=true

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limit
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Database (MySQL)
DB_USER_NAME=root
DB_PASSWORD=root
DB_NAME=ta_project
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql
DB_LOG=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672
RABBITMQ_CHAT_QUEUE=chat.llm.requests
RABBITMQ_CHAT_REPLY_TIMEOUT_MS=120000

# MQTT
MQTT_BROKER_URL=
MQTT_CLIENT_ID=
MQTT_USERNAME=
MQTT_PASSWORD=

# Secrets
SECRET_KEY_ENCRYPTION=
SECRET_PASSWORD_ENCRYPTION=
SECRET_PIN_ENCRYPTION=
JWT_TOKEN=change-me-in-production

# LLM providers
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Text-to-speech
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=
PINECONE_EMBEDDING_MODEL=
