    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pinecone-database/pinecone": "^2.2.0",
    "@whiskeysockets/baileys": "^6.6.0",
    "amqplib": "^0.10.3",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "bullmq": "^4.15.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "langchain": "^1.5.11",
    "morgan": "^1.10.0",
    "mqtt": "^5.3.0",
    "mysql2": "^3.6.5",
    "pino": "^8.17.1",
    "qrcode": "^1.5.3",
    "sequelize": "^6.35.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "ws": "^8.14.2",
    "zod": "^4.1.12"
