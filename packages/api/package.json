  "devDependencies": {
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-typescript": "^7.23.3",
    "@jest/globals": "^29.7.0",
    "@types/amqplib": "^0.10.4",
    "@types/body-parser": "^1.19.5",
