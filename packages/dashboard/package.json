    "amqplib": "^0.10.3",
    "apexcharts": "^3.45.0",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "bullmq": "^4.11.5",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.0.0",
    "firebase": "^10.7.2",
    "helmet": "^7.1.0",
