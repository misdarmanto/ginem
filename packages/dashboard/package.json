    "mysql2": "^3.6.5",
    "pino": "^8.16.2",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-apexcharts": "^1.4.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.65.0",
    "react-responsive-carousel": "^3.2.23",
    "react-router-dom": "^6.21.0",
    "sequelize": "^6.35.1",
    "sort-by": "^1.2.0",
    "styled-components": "^6.1.3",
