{
  "name": "ginem",
  "version": "1.0.0",
  "description": "Full-stack application with React frontend and Express backend",
  "type": "module",
  "main": "build/server.js",
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx watch server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\" --names \"FRONTEND,BACKEND\" --prefix \"[{name}]\" --kill-others-on-exit",
    "build": "tsc && vite build",
    "build:backend": "tsc",
    "preview": "vite preview",
    "start": "node build/server.js",
    "start:prod": "npm run build && npm run build:backend && node build/server.js",
    "lint": "eslint . --ext ts,tsx",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@hookform/resolvers": "^5.2.2",
    "@langchain/anthropic": "^0.0.10",
    "@langchain/core": "^0.1.0",
    "@langchain/deepseek": "^0.0.1",
    "@langchain/openai": "^0.0.10",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.1",
    "@mui/styled-engine-sc": "^6.0.0-alpha.8",
    "@mui/x-data-grid": "^6.18.6",
    "@mui/x-data-grid-generator": "^6.18.6",
    "@pinecone-database/pinecone": "^2.1.0",
    "@tanstack/react-query": "^5.101.2",
