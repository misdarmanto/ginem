  {
    "type": "function",
    "function": {
      "name": "create_device_log",
      "description": "Create a new device log for a device. Use the device name (deviceName) to identify the device, not deviceId. Use when the user wants to add a value, record a reading, or create a device log for a device by name. Do NOT use for turn on/off (hidupkan/matikan) — use set_actuator_state_by_device_name instead.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "description": "The exact device name (identifies which device to add the value to)"
          },
          "deviceLogData": {
            "type": "string",
            "minLength": 1,
            "description": "The data to store for this device log"
          }
        },
        "required": [
          "deviceName",
          "deviceLogData"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_actuator_state_by_device_name",
      "description": "Turn ON or OFF an actuator device immediately by its name. Use for instant control without scheduling.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "description": "The exact device name (must be an actuator)"
          },
          "state": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ],
            "description": "on = hidupkan, off = matikan"
          }
        },
        "required": [
          "deviceName",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "schedule_actuator_state_at",
      "description": "Schedule actuator ON/OFF with category once or repeat (WIB). ONCE examples: \"hidupkan lampu depan di jam 18:00 WIB\" → category=once, hour=18, minute=0 (no date). \"hidupkan lampu depan di 20-06-2026 jam 18:00\" → category=once, date=\"20-06-2026\", hour=18, minute=0. REPEAT examples: \"hidupkan lampu depan setiap hari jam 18:00 WIB\" → category=repeat, hour=18, minute=0. \"matikan lampu depan setiap jam 06:00\" → category=repeat, hour=6, minute=0. User may request TWO separate jobs for daily on and daily off.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "description": "The exact device name (must be an actuator)"
          },
          "state": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ],
            "description": "on = hidupkan, off = matikan"
          },
          "category": {
            "type": "string",
            "enum": [
              "once",
              "repeat"
            ],
            "description": "once = run ONE time only (e.g. \"hidupkan lampu jam 18:00\" today, or \"20-06-2026 jam 18:00\"). repeat = EVERY DAY at hour:minute WIB (e.g. \"setiap hari jam 18:00\", \"setiap jam 06:00 matikan\")."
          },
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "description": "Hour 0–23 (24h, WIB). Required. e.g. \"jam 10:11\" → hour=10"
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "description": "Minute 0–59. Required. e.g. \"jam 10:11\" → minute=11"
          },
          "date": {
            "description": "For category=once only. Specific date DD-MM-YYYY (e.g. \"20-06-2026\") or YYYY-MM-DD. Omit for time-only (defaults to today WIB).",
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 2024,
            "maximum": 2100
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          }
        },
        "required": [
          "deviceName",
          "state",
          "category",
          "hour",
          "minute"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "schedule_sensor_data_at",
      "description": "Schedule sensor data fetch with category once or repeat (WIB). ONCE: specific time or date+time. REPEAT: every day at hour:minute (omit date).",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "deviceName": {
            "type": "string",
            "minLength": 1,
            "description": "The exact device name to fetch data from"
          },
          "category": {
            "type": "string",
            "enum": [
              "once",
              "repeat"
            ],
            "description": "once = run ONE time only (e.g. \"hidupkan lampu jam 18:00\" today, or \"20-06-2026 jam 18:00\"). repeat = EVERY DAY at hour:minute WIB (e.g. \"setiap hari jam 18:00\", \"setiap jam 06:00 matikan\")."
          },
          "hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23,
            "description": "Hour 0–23 (24h, WIB). Required. e.g. \"jam 10:11\" → hour=10"
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 59,
            "description": "Minute 0–59. Required. e.g. \"jam 10:11\" → minute=11"
          },
          "date": {
            "description": "For category=once only. Specific date DD-MM-YYYY (e.g. \"20-06-2026\") or YYYY-MM-DD. Omit for time-only (defaults to today WIB).",
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 2024,
            "maximum": 2100
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31
          }
        },
        "required": [
          "deviceName",
          "category",
          "hour",
          "minute"
        ],
        "additionalProperties": false
      }
    }
  },
