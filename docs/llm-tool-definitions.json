  {
    "type": "function",
    "function": {
      "name": "create_automation_rule",
      "description": "Create an Event-Condition-Action automation rule from natural language intent. Use when the user wants automatic cooperation between devices (e.g. \"turn on fan if temperature > 25\"). Do NOT use for immediate on/off (use set_actuator_state_by_device_name) or time schedules (use schedule_*). Trigger device must be a sensor; action devices must be an actuator. Metric is a string like temperature or humidity.",
      "parameters": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "originalPrompt": {
            "type": "string",
            "minLength": 1,
            "description": "The user original natural-language request"
          },
          "conditionLogic": {
            "default": "AND",
            "type": "string",
            "enum": [
              "AND",
              "OR"
            ]
          },
          "cooldownSec": {
            "default": 60,
            "type": "integer",
            "minimum": 0,
            "maximum": 86400
          },
          "isActive": {
            "default": true,
            "type": "boolean"
          },
          "trigger": {
            "type": "object",
            "properties": {
              "deviceName": {
                "type": "string",
                "minLength": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "deviceName",
              "metric"
            ],
            "additionalProperties": false
          },
          "conditions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "deviceName": {
                  "type": "string",
                  "minLength": 1
                },
                "metric": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    ">",
                    ">=",
                    "<",
                    "<=",
                    "==",
                    "!="
                  ]
                },
                "threshold": {
                  "type": "number"
                },
                "unit": {
                  "type": "string",
                  "maxLength": 32
                }
              },
              "required": [
                "metric",
                "operator",
                "threshold"
              ],
              "additionalProperties": false
            }
          },
          "actions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "deviceName": {
                  "type": "string",
                  "minLength": 1
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "on",
                    "off"
                  ]
                }
              },
              "required": [
                "deviceName",
                "state"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "originalPrompt",
          "conditionLogic",
          "cooldownSec",
          "isActive",
          "trigger",
          "conditions",
          "actions"
        ],
        "additionalProperties": false
      }
    }
  },
